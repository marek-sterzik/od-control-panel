<!DOCTYPE html>
<html lang="cs">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Control panel{% endblock %}</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        <link rel="stylesheet" href="{{ theme_asset('style.css') }}">

        {% include "header.html.twig" %}

        {% block js %}
        {% endblock %}
    </head>
    <body class="bg-light">
        <nav class="navbar navbar-expand-lg navbar-light bg-white mb-4 shadow-sm">
            <div class="container-fluid px-3 px-md-4">
                <a class="navbar-brand fw-semibold fs-5" href="#">Control Panel</a>
                
                <button class="navbar-toggler border-0 p-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Přepnout navigaci">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end mt-3 mt-lg-0" id="navbarNav">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3 w-100 justify-content-end">
                        
                        {% if user is not null %}
                            <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 text-secondary small py-2 py-lg-0 pb-3 pb-lg-0">
                                <div>
                                    Přihlášen: <span class="badge {% if user.admin %}bg-danger{% else %}bg-primary{% endif %} px-2 py-1 text-white">{{ user.name }}</span>
                                </div>
                                <div>
                                    <a href="{{ path("app.logout") }}" class="text-decoration-none link-danger fw-medium">Odhlásit</a>
                                </div>
                            </div>
                        {% endif %}

                        <div class="themeselect w-sm-100 w-lg-auto">
                            <form action="{{ path("app.set-theme") }}" method="get" class="m-0">
                                <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                                <select class="form-select form-select-sm border-secondary submit-on-change w-100" name="theme" aria-label="Výběr motivu">
                                    {% for theme in themes %}
                                        <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>
                                            {{ theme.description }} ({{ theme.author }})
                                        </option>
                                    {% endfor %}
                                </select>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <main class="container px-3 px-md-4 mb-5">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>