{% extends theme_template("base.html.twig") %}

{% block body %}
    <div class="row justify-content-center mt-5">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header text-white">
                    <h1 class="h4 mb-0 text-center text-danger">{{ errorCaption }}</h1>
                </div>
                <div class="card-body">
                    <p class="card-text fs-5 text-secondary text-center">{{ errorMessage }}</p>
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        {% if retryUrl is not null %}
                            <a role="button" href="{{ retryUrl }}" class="btn btn-outline-danger">Zkusit znovu</a>
                        {% endif %}
                        {% if backUrl is not null %}
                            <a role="button" href="{{ backUrl }}" class="btn btn-outline-danger">Zpět</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}