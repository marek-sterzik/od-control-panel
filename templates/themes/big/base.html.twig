<!doctype html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Control Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    {% include "header.html.twig" %}
    {% block scripts %}{% endblock %}
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="page-actions">
        <form class="theme-switcher" action="{{ path("app.set-theme") }}" method="get">
            <input type="hidden" name="back" value="{{ app.request.requesturi }}">
            <select class="submit-on-change" name="theme">
                {% for theme in themes %}
                    <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }} ({{ theme.author }})</option>
                {% endfor %}
            </select>
        </form>
        {% if user is not null %}
            <a class="logout-button" href="{{ path('app.logout') }}">Odhlásit se</a>
        {% endif %}
    </div>
    {% block body %}{% endblock %}
</body>
</html>