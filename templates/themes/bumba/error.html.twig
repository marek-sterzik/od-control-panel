{% extends theme_template("base.html.twig") %}

{% block content %}
    <div class="container d-flex flex-grow-1 justify-content-center align-items-center px-3 w-100 mt-5 pt-5">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 text-center" style="max-width: 450px; width: 100%;">
            
            <div class="mb-3">
                <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>
            </div>

            <h1 class="fs-4 fw-bold text-body-secondary mb-2">Chyba: {{ errorCaption }}</h1>
            <p class="text-muted mb-4">{{ errorMessage }}</p>
            
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                {% if retryUrl is not null %}
                    <a href="{{ retryUrl }}" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-arrow-repeat"></i> Zkusit znovu
                    </a>
                {% endif %}
                
                {% if backUrl is not null %}
                    <a href="{{ backUrl }}" class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-arrow-left"></i> Zpět
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
{% endblock %}