<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Control panel{% endblock %}</title>
    
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="{{ theme_asset('base.css') }}">

    {% block stylesheets %}
    {% endblock %}

    {% include "header.html.twig" %}
    {% block scripts %}
    <script>
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
    </script>
    {% endblock %}
    
</head>
<body class="bg-body-tertiary position-relative d-flex flex-column min-vh-100">
    <div class="position-absolute top-0 end-0 p-3 d-flex align-items-center gap-2 gap-sm-3 z-3">
        {% block extra_header_buttons %}{% endblock %}
        <div class="theme-toggle-wrapper mt-1">
            <input type="checkbox" id="themeToggle" class="theme-toggle-checkbox">
            <label for="themeToggle" class="theme-toggle-label">
                <div class="theme-toggle-ball" id="themeToggleBall">☀️</div>
            </label>
        </div>
        
        <button class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-bold text-nowrap d-flex align-items-center gap-2 bg-body-tertiary shadow-sm" data-bs-toggle="modal" data-bs-target="#templatesModal">
            <i class="bi bi-collection"></i>
            <span class="d-none d-sm-inline">Šablony</span>
        </button>
    </div>

    {% block content %}{% endblock %}

    <!-- Global Window with themes -->
    <div class="modal fade" id="templatesModal" tabindex="-1" aria-labelledby="templatesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h1 class="modal-title fs-4 fw-bold">Dostupné šablony</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-4">Vyberte si z komunitních panelů nebo nahrajte jinou sadu.</p>
                    <div class="list-group list-group-flush gap-2">

                        {% for theme in themes %}
                            <form action="{{ path('app.set-theme') }}" method="get" class="m-0 p-0 w-100">
                                <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                                <input type="hidden" name="theme" value="{{ theme.theme }}">

                                <div class="list-group-item d-flex justify-content-between align-items-center border rounded-3 p-3 {% if theme.active %}border-primary bg-primary bg-opacity-10{% endif %}">
                                    <div>
                                        <h6 class="mb-1 fw-bold">
                                            {{ theme.description }}
                                            {% if theme.active %}
                                                <span class="badge bg-primary ms-1">Aktuální</span>
                                            {% endif %}
                                        </h6>
                                        <small class="text-muted"><i class="bi bi-person-fill"></i> {{ theme.author }}</small>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3" {% if theme.active %}disabled{% endif %}>
                                        {% if theme.active %}Vybráno{% else %}Použít{% endif %}
                                    </button>
                                </div>
                            </form>
                        {% else %}
                            <div class="text-center text-muted p-4">
                                Žádné šablony nejsou k dispozici.
                            </div>
                        {% endfor %}

                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Dark mode přepínač
            const toggle = document.getElementById('themeToggle');
            const ball = document.getElementById('themeToggleBall');
            if (toggle && ball) {
                const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                toggle.checked = isDark;
                ball.textContent = isDark ? '🌙' : '☀️';

                toggle.addEventListener('change', e => {
                    const theme = e.target.checked ? 'dark' : 'light';
                    document.documentElement.setAttribute('data-bs-theme', theme);
                    localStorage.setItem('theme', theme);
                    ball.textContent = e.target.checked ? '🌙' : '☀️';
                });
            }
        });
    </script>
</body>
</html>