<style>
    .theme-toggle-wrapper { display: inline-block; }
    .theme-toggle-checkbox { display: none; }
    .theme-toggle-label {
        width: 54px; height: 28px; background-color: #4facfe; border-radius: 50px;
        position: relative; cursor: pointer; transition: 0.5s ease; margin-bottom: 0;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    [data-bs-theme="dark"] .theme-toggle-label { background-color: #2c3e50; }
    .theme-toggle-ball {
        width: 20px; height: 20px; background-color: #fff; border-radius: 50%;
        position: absolute; top: 4px; left: 4px; display: flex; align-items: center; justify-content: center;
        font-size: 11px; transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }
    .theme-toggle-checkbox:checked + .theme-toggle-label .theme-toggle-ball { transform: translateX(26px) rotate(360deg); }
</style>

<!-- --- Horní lišta v pravém rohu --- -->
<div class="position-absolute top-0 end-0 p-3 d-flex align-items-center gap-2 gap-sm-3 z-3">
    <div class="theme-toggle-wrapper mt-1">
        <input type="checkbox" id="themeToggle" class="theme-toggle-checkbox">
        <label for="themeToggle" class="theme-toggle-label">
            <div class="theme-toggle-ball" id="themeToggleBall">☀️</div>
        </label>
    </div>

    {% if showLogout|default(false) %}
        <a href="{{ logoutUrl|default('login') }}" class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-bold text-nowrap d-flex align-items-center gap-2 bg-body-tertiary shadow-sm">
            <i class="bi bi-box-arrow-right"></i>
            <span class="d-none d-sm-inline">Odhlásit</span>
        </a>
    {% endif %}
    
    <button class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-bold text-nowrap d-flex align-items-center gap-2 bg-body-tertiary shadow-sm" data-bs-toggle="modal" data-bs-target="#templatesModal">
        <i class="bi bi-collection"></i>
        <span class="d-none d-sm-inline">Šablony</span>
    </button>
</div>

<script>

    document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('themeToggle');
        const ball = document.getElementById('themeToggleBall');
        if (toggle && ball) {
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            toggle.checked = isDark;
            ball.textContent = isDark ? '🌙' : '☀️';

            toggle.addEventListener('change', e => {
                const theme = e.target.checked ? 'dark' : 'light';
                document.documentElement.setAttribute('data-bs-theme', theme);
                localStorage.setItem('theme', theme);
                ball.textContent = e.target.checked ? '🌙' : '☀️';
            });
        }
    });
</script>