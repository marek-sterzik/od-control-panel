{% extends theme_template("base.html.twig") %}
{% block title %}Chyba · Jarda{% endblock %}

{% block body %}
    <div class="row justify-content-center py-4">
        <div class="col-12 col-lg-8">
            <section class="card">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">Chyba: {{ errorCaption }}</h1>
                    <p class="mb-4">{{ errorMessage }}</p>
                    <div class="d-flex flex-wrap gap-2">
                        {% if retryUrl is not null %}<a class="btn btn-primary" href="{{ retryUrl }}">Zkusit znovu</a>{% endif %}
                        {% if backUrl is not null %}<a class="btn btn-secondary" href="{{ backUrl }}">Jít zpět</a>{% endif %}
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}
