<!DOCTYPE html>
<html lang="cs">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}J · Ovládací panel{% endblock %}</title>
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}
        {% include "header.html.twig" %}
        {% block scripts %}
        {% endblock %}
    </head>
    <body class="theme-dark">
        <nav class="navbar navbar-dark bg-dark">
            <div class="container">
                <span class="navbar-brand mb-0">JK</span>
                <div class="d-flex flex-wrap align-items-center justify-content-end gap-3">
                    <label class="theme-toggle d-flex align-items-center gap-2 text-light small" for="darkModeToggle">
                        <span>Tmavý režim</span>
                        <input id="darkModeToggle" class="form-check-input" type="checkbox" role="switch" aria-label="Přepnout tmavý režim">
                    </label>
                    {% if user is not null %}
                        <div class="text-end text-light small">
                            Přihlášený uživatel: <strong{% if user.admin %} class="admin"{% endif %}>{{ user.name }}</strong>
                            <a class="text-info" href="{{ path('app.logout') }}">Odhlásit se</a>
                        </div>
                    {% endif %}
                    <form action="{{ path('app.set-theme') }}" method="get">
                        <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                        <select class="form-select form-select-sm submit-on-change" name="theme" aria-label="Vyberte téma">
                            {% for theme in themes %}
                                <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }} · {{ theme.author }}</option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
            </div>
        </nav>
        <main class="container py-4">
            {% block body %}{% endblock %}
        </main>
        <script>
            (function () {
                const body = document.body;
                const toggle = document.getElementById('darkModeToggle');
                const savedTheme = localStorage.getItem('od-control-theme');
                const shouldUseDark = savedTheme ? savedTheme === 'dark' : true;

                function applyTheme(isDark) {
                    body.classList.toggle('theme-dark', isDark);
                    body.classList.toggle('theme-light', !isDark);
                    localStorage.setItem('od-control-theme', isDark ? 'dark' : 'light');
                    if (toggle) {
                        toggle.checked = isDark;
                    }
                }

                applyTheme(shouldUseDark);

                if (toggle) {
                    toggle.addEventListener('change', function () {
                        applyTheme(this.checked);
                    });
                }
            })();
        </script>
    </body>
</html>
