{% extends theme_template("base.html.twig") %}

{% block scripts %}
        {{ parent() }}
        <script src="{{ theme_asset('main.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Ovládací panel</h1>
            <p class="text-muted mb-0">Ovládání kontrolek a segmentového displeje</p>
        </div>
        <span class="badge text-bg-success">Živé spojení</span>
    </div>

    <div class="row g-3">
        {% for component in controls %}
            <div class="col-12{% if component.type == 'switch' %} col-md-6 col-xl-4{% endif %}" data-metrix-id="{{ component.id }}">
                {% if component.type == 'switch' %}
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <span class="light-dot" style="color: {{ component.color }}; background-color: {{ component.color }}" aria-hidden="true">
                                {% for ray in 1..8 %}<i class="light-ray"></i>{% endfor %}
                            </span>
                            <h2 class="h5 flex-grow-1 mb-0">{{ component.caption }}</h2>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" data-part="state" aria-label="Zapnout {{ component.caption }}" {% if component.state %}checked="checked"{% endif %}>
                            </div>
                        </div>
                        {% if 'blink' in component.parts %}
                            <div class="card-footer d-flex justify-content-between align-items-center">
                                <span>Blikání</span>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" data-part="blink" aria-label="Blikání {{ component.caption }}" {% if component.blink %}checked="checked"{% endif %}>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% elseif component.type == 'segment' %}
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h4 mb-3">{{ component.caption }}</h2>
                            <div class="segments-display">
                                {% for index, digit in component.segment_state %}
                                    <section class="segment" data-digit="{{ index }}" data-value="{{ digit }}" aria-label="Číslice {{ index + 1 }}">
                                        <div data-segment="0"></div>
                                        <span data-segment="1"></span>
                                        <span data-segment="2"></span>
                                        <div data-segment="3"></div>
                                        <span data-segment="4"></span>
                                        <span data-segment="5"></span>
                                        <div data-segment="6"></div>
                                        <div class="dot" data-segment="7"></div>
                                    </section>
                                {% endfor %}
                            </div>

                            <div class="mt-4">
                                <label class="form-label" for="{{ component.id }}-category">Kategorie znaků</label>
                                <select id="{{ component.id }}-category" class="form-select cycle-category">
                                    <option value="">Výchozí (hexadecimální)</option>
                                    <option value="digit">Číslice</option>
                                    <option value="hex">Hexadecimální číslice</option>
                                    <option value="letteropt">Písmena</option>
                                    <option value="lower">Malá písmena</option>
                                    <option value="upper">Velká písmena</option>
                                    <option value="letter">Všechna písmena</option>
                                </select>
                                <p class="form-text">Segmenty lze přepínat kliknutím. Tlačítka − a + mění znak ve vybrané kategorii.</p>
                            </div>

                            <div class="segment-text">
                                {% for index, text in component.state %}
                                    <div class="input-group digit-editor">
                                        <button class="btn btn-outline-secondary" type="button" data-direction="prev" data-digit="{{ index }}" aria-label="Předchozí znak">−</button>
                                        <button class="btn btn-outline-secondary" type="button" data-direction="next" data-digit="{{ index }}" aria-label="Další znak">+</button>
                                        <input class="form-control text-center" type="text" maxlength="2" data-digit="{{ index }}" data-expected-value="{{ text|default('') }}" value="{{ text|default('') }}" aria-label="Znak číslice {{ index + 1 }}">
                                        <button class="btn btn-outline-secondary" type="button" data-direction="wipe" data-digit="{{ index }}">Vymazat</button>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-warning">Neznámý typ komponenty: {{ component.type }}</div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endblock %}
