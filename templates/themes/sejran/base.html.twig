<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
        <title>{% block title %}ZONE TERMINAL v1.42{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}
        {% include "header.html.twig" %}
        {% block scripts %}
        {% endblock %}
    </head>
    <body class="stalker-body">
        <div class="scanlines"></div>

        <div class="top-bar">
            <div class="themeselect">
                <form action="{{ path("app.set-theme") }}" method="get">
                    <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                    <select class="submit-on-change stalker-select" name="theme">
                        {% for theme in themes %}
                            <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>[{{ theme.description }} - {{ theme.author }}]</option>
                        {% endfor %}
                    </select>
                </form>
            </div>
            {% if user is not null %}
                <div class="userinfo">
                    ID OPERÁTORA: <span{% if user.admin %} class="admin"{% endif %}>{{ user.name }}</span> [<a href="{{ path("app.logout") }}">ODHLÁSIT</a>]
                </div>
            {% endif %}
            <div style="clear: both"></div>
        </div>

        <div class="container-zone">
            <div class="zone-header-banner">
                <span class="warning-sign">⚠ WARNING: HIGH RADIATION LEVEL DETECTED ⚠</span>
            </div>
            <h1 class="main-title">Z.O.N.E. CONTROL INTERFACE</h1>
            {% block body %}{% endblock %}
        </div>
    </body>
</html>