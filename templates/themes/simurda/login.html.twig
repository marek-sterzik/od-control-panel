{% extends theme_template("base.html.twig") %}

{% block title %}Přihlášení - The Frutiger Theme{% endblock %}
{% block body_class %}login-page{% endblock %}

{% block body %}
    <main class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
        <section class="card p-4 login-card">
            <h1 class="h2 text-center mb-4 text-primary">Přihlášení</h1>

            <form method="post">
                {% if loginError %}
                    <div class="alert alert-danger py-2" role="alert">
                        Přihlášení se nezdařilo, zkontrolujte heslo.
                    </div>
                {% endif %}

                <div class="mb-3">
                    <label for="username" class="form-label">Uživatel:</label>
                    <select name="username" id="username" class="form-select">
                        {% for username, name in users %}
                            <option value="{{ username }}"{% if username == selectedUser %} selected="selected"{% endif %}>{{ name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Heslo:</label>
                    <input type="password" name="password" id="password" class="form-control">
                </div>

                <button type="submit" class="btn btn-success w-100">Přihlásit se</button>
            </form>
        </section>
    </main>
{% endblock %}