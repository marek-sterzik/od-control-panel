{% extends theme_template("base.html.twig") %}

{% block body %}
<div class="row justify-content-center my-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Chyba: {{ errorCaption }}</h4>
            </div>
            <div class="card-body">
                <p class="card-text fs-5">{{ errorMessage }}</p>
                <div class="d-flex gap-2 justify-content-end mt-4">
                    {% if backUrl is not null %}
                        <a href="{{ backUrl }}" class="btn btn-outline-secondary">Zpět</a>
                    {% endif %}
                    {% if retryUrl is not null %}
                        <a href="{{ retryUrl }}" class="btn btn-danger">Zkusit znovu</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}