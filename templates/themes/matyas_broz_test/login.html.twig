{% extends theme_template("base.html.twig") %}

{% block body %}
<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">Přihlášení</h3>

                {% if loginError %}
                    <div class="alert alert-danger" role="alert">
                        Přihlášení se nezdařilo. Zkontrolujte zadané heslo.
                    </div>
                {% endif %}

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Uživatel</label>
                        <select name="username" class="form-select">
                            {% for username, name in users %}
                                <option value="{{ username }}"{% if username == selectedUser %} selected="selected"{% endif %}>{{ name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Heslo</label>
                        <input type="password" name="password" class="form-control" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Přihlásit se</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}