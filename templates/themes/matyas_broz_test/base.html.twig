<!DOCTYPE html>
<html lang="cs">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Control Panel{% endblock %}</title>

        <!-- Bootstrap 5 CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- Bootstrap Icons -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}

        {% include "header.html.twig" %}

        <!-- jQuery & Bootstrap JS -->
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

        {% block scripts %}
        {% endblock %}
    </head>
    <body class="bg-light text-dark">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="#">
                    <i class="bi bi-cpu me-2"></i>Control Panel
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="ms-auto d-flex flex-column flex-lg-row align-items-lg-center gap-3 mt-2 mt-lg-0">
                        {% if user is not null %}
                            <div class="text-white-50 small">
                                Přihlášen: 
                                <span class="fw-bold text-white {% if user.admin %}text-danger{% endif %}">
                                    {{ user.name }} {% if user.admin %}<span class="badge bg-danger ms-1">Admin</span>{% endif %}
                                </span>
                                <a href="{{ path("app.logout") }}" class="btn btn-outline-light btn-sm ms-2">Odhlásit</a>
                            </div>
                        {% endif %}

                        <div class="themeselect">
                            <form action="{{ path("app.set-theme") }}" method="get" class="m-0">
                                <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                                <select class="form-select form-select-sm bg-secondary text-white border-0 submit-on-change" name="theme">
                                    {% for theme in themes %}
                                        <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>
                                            {{ theme.description }} ({{ theme.author }})
                                        </option>
                                    {% endfor %}
                                </select>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <main class="container">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>