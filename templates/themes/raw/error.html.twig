<!DOCTYPE html>
<html lang="cs" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Systémová chyba</title>
    
    {% include "header.html.twig" %}
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ theme_asset('style.css') }}" rel="stylesheet">
</head>
<body class="bg-body-tertiary d-flex align-items-center justify-content-center min-vh-100">

    <main class="container px-3 text-center">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card border-danger shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-danger text-white p-4">
                        <h1 class="h4 fw-bold mb-0">Chyba: {{ errorCaption }}</h1>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <p class="fs-5 text-body-secondary mb-4">{{ errorMessage }}</p>
                        
                        <div class="d-flex justify-content-center gap-3">
                            {% if retryUrl is not null %}
                                <a href="{{ retryUrl }}" class="btn btn-primary px-4 fw-semibold">Zkusit znovu</a>
                            {% endif %}
                            {% if backUrl is not null %}
                                <a href="{{ backUrl }}" class="btn btn-outline-secondary px-4">Zpět</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>