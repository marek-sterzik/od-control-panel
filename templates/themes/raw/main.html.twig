<!DOCTYPE html>
<html lang="cs" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Systémový panel</title>
    
    {% include "header.html.twig" %}
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="{{ theme_asset('style.css') }}" rel="stylesheet">
</head>
<body class="min-vh-100 pb-5">

    <div class="p-3 d-flex flex-column flex-sm-row justify-content-end align-items-end align-items-sm-center gap-2">
        {% if user is not null %}
            <div class="badge bg-secondary fs-6 rounded-pill px-3 py-2">
                <i class="bi bi-person-circle me-1"></i>
                <span {% if user.admin %}class="text-warning fw-bold"{% endif %}>{{ user.name }}</span>
                <a href="{{ path('app.logout') }}" class="text-light ms-2 text-decoration-none border-start ps-2">Odhlásit</a>
            </div>
        {% endif %}

        <form action="{{ path('app.set-theme') }}" method="get" class="m-0">
            <input type="hidden" name="back" value="{{ app.request.requesturi }}">
            <div class="dropdown">
                <button class="btn btn-outline-secondary fw-bold rounded-pill px-3 py-2 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    Motiv vzhledu
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2 p-2">
                    {% for theme in themes %}
                        <li>
                            <button type="submit" name="theme" value="{{ theme.theme }}" class="dropdown-item rounded fw-medium {% if theme.active %}active bg-info text-dark{% endif %}">
                                {{ theme.description }} <small class="opacity-75">({{ theme.author }})</small>
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </form>
    </div>

    <main class="container px-3 mt-2">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                
                <header class="mb-4 pb-2 border-bottom border-secondary-subtle">
                    <h1 class="h3 mb-0 fw-bold">Ovládací panel</h1>
                </header>

                <div class="row g-3">
                    {% for component in controls %}
                        <div class="col-12" data-metrix-id="{{ component.id }}">
                            
                            {% if component.type == "switch" %}
                                <div class="card shadow-lg rounded-4 switch-card">
                                    <div class="card-body p-3 d-flex align-items-center gap-3">
                                        
                                        <input type="checkbox" id="led_{{ component.id }}" class="led-indicator" data-part="state" style="--led-color: {{ component.color }};" {% if component.state %}checked="checked"{% endif %}>
                                        
                                        <div class="flex-grow-1">
                                            <label class="fs-5 fw-bold text-light mb-0" for="led_{{ component.id }}" style="cursor:pointer;">{{ component.caption }}</label>
                                            
                                            {% if "blink" in component.parts %}
                                                <div class="form-check mt-1 mb-0 p-0 d-flex align-items-center">
                                                    <input class="form-check-input bg-dark m-0 me-2" type="checkbox" id="blink_{{ component.id }}" data-part="blink" {% if component.blink %}checked="checked"{% endif %}>
                                                    <label class="form-check-label text-secondary small" for="blink_{{ component.id }}" style="cursor:pointer;">Režim blikání</label>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            
                            {% elseif component.type == "segment" %}
                                <div class="card shadow-lg rounded-4 mt-3">
                                    <div class="card-header border-0 py-3">
                                        <h2 class="h5 mb-0 fw-bold">{{ component.caption }}</h2>
                                    </div>
                                    
                                    <div class="card-body p-3 p-md-4 pt-0">
                                        
                                        <div class="text-center mb-4 mt-2">
                                            <div class="display-container">
                                                {% for index, digit in component.segment_state %}
                                                    <section class="segment" data-digit="{{ index }}" data-value="{{ digit }}">
                                                        <div data-segment="0"></div>
                                                        <span data-segment="1"></span>
                                                        <span data-segment="2"></span>
                                                        <div data-segment="3"></div>
                                                        <span data-segment="4"></span>
                                                        <span data-segment="5"></span>
                                                        <div data-segment="6"></div>
                                                        <div class="dot" data-segment="7"></div>
                                                    </section>
                                                {% endfor %}
                                            </div>
                                        </div>

                                        <hr class="border-secondary-subtle my-4">

                                        <h3 class="h6 mb-2 text-secondary">Textové vyjádření</h3>
                                        <div class="mb-4">
                                            <select class="form-select cycle-category bg-dark text-light border-secondary">
                                                <option class="default" value="">Vyberte kategorii znaků</option>
                                                <option value="digit">Číslice (0-9)</option>
                                                <option value="hex">Hexadecimální (0-F)</option>
                                                <option value="letteropt">Písmena (Optimální)</option>
                                                <option value="lower">Malá písmena (a-z)</option>
                                                <option value="upper">Velká písmena (A-Z)</option>
                                                <option value="letter">Všechna písmena</option>
                                            </select>
                                        </div>
                                        
                                        <div class="segment-text d-flex flex-column gap-3">
                                            {% for index, text in component.state %}
                                                <div class="d-flex align-items-center justify-content-between p-2 rounded bg-dark border border-secondary-subtle">
                                                    <span class="text-secondary small fw-bold ms-1">Pozice {{ index + 1 }}</span>
                                                    
                                                    <div class="d-flex align-items-center gap-2">
                                                        
                                                        <div class="input-group input-group-sm flex-nowrap shadow-sm" style="width: 120px;">
                                                            <button class="btn btn-outline-secondary border-secondary" type="button" data-direction="prev" data-digit="{{ index }}">
                                                                <i class="bi bi-dash"></i>
                                                            </button>
                                                            <input type="text" class="form-control text-center fw-bold bg-dark border-secondary text-light px-0" 
                                                                   data-digit="{{ index }}" 
                                                                   data-expected-value="{% if text == '' %} {% else %}{{ text }}{% endif %}" 
                                                                   value="{{ text }}" readonly>
                                                            <button class="btn btn-outline-secondary border-secondary" type="button" data-direction="next" data-digit="{{ index }}">
                                                                <i class="bi bi-plus"></i>
                                                            </button>
                                                        </div>
                                                        
                                                        <button class="btn btn-outline-danger btn-sm shadow-sm ms-1 px-2" type="button" data-direction="wipe" data-digit="{{ index }}" title="Vymazat znak">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                        
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>

                                    </div>
                                </div>
                            
                            {% else %}
                                <div class="alert alert-warning">Neznámý modul: {{ component.type }}</div>
                            {% endif %}
                            
                        </div>
                    {% endfor %}
                </div>

            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ theme_asset('main.js') }}"></script>
</body>
</html>