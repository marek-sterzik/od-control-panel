{% extends theme_template("base.html.twig") %}

{% block scripts %}
    <script src="{{ theme_asset("main.js") }}"></script>
{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 bg-white p-3 rounded border shadow-sm">
    <h2 class="fw-bold fs-4 m-0"><i class="bi bi-sliders text-primary me-2"></i>Ovládací panel</h2>
    
    <div class="d-flex align-items-center gap-2 ms-auto">
        {% if user is not null %}

            <span class="text-muted small">
                Uživatel: <strong class="text-dark">{{ user.name }}</strong>
            </span>
            <a href="{{ path("app.logout") }}" class="btn btn-outline-danger btn-sm fw-semibold">
                <i class="bi bi-box-arrow-right me-1"></i>Odhlásit
            </a>
        {% endif %}
    </div>
</div>

<div class="row g-4">

    <div class="col-12 col-lg-6">
        <div class="card bg-white border shadow-sm h-100">
            <div class="card-header bg-light border-bottom fw-bold text-dark py-3">
                <i class="bi bi-lightbulb me-2 text-primary"></i>Hardwarové kontrolky
            </div>
            <div class="card-body p-3 d-flex flex-column gap-3">
                {% for component in controls %}
                    {% if component.type == "switch" %}
                        <div class="switch-row p-3 rounded border bg-light-subtle d-flex flex-column gap-2" data-metrix-id="{{ component.id }}" data-color="{{ component.color }}">
                            <div class="d-flex align-items-center gap-2">
                                <span class="led-indicator rounded-circle shadow-sm" style="width: 12px; height: 12px; background-color: #ccc; display: inline-block;"></span>
                                <div class="form-check form-switch fs-6 m-0">
                                    <input class="form-check-input" type="checkbox" data-part="state" {% if component.state %}checked="checked"{% endif %} id="sw-{{ component.id }}" style="transform: scale(1.1); margin-right: 6px;">
                                    <label class="form-check-label fw-bold text-dark small" for="sw-{{ component.id }}">{{ component.caption }}</label>
                                </div>
                            </div>
                            
                            {% if "blink" in component.parts %}
                                <div class="ms-4 ps-2">
                                    <div class="form-check form-switch m-0 bg-white px-2 py-1 rounded border d-inline-flex align-items-center gap-1 shadow-sm">
                                        <input class="form-check-input m-0" type="checkbox" data-part="blink" {% if component.blink %}checked="checked"{% endif %} id="blink-{{ component.id }}">
                                        <label class="form-check-label text-muted small ms-1" for="blink-{{ component.id }}" style="font-size: 0.8rem;">Blikání</label>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>


    <div class="col-12 col-lg-6">
        {% for component in controls %}
            {% if component.type == "segment" %}
                <div class="card bg-white border shadow-sm h-100" data-metrix-id="{{ component.id }}">
                    <div class="card-header bg-light border-bottom fw-bold text-dark py-3">
                        <i class="bi bi-display me-2 text-primary"></i>{{ component.caption }}
                    </div>
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div>

                            <h5 class="text-muted small mb-3 text-center">Vizuální stav displeje</h5>
                            <div class="segments d-flex justify-content-center align-items-center gap-2 gap-sm-4 mb-4 py-3 px-2 bg-dark rounded border shadow-inner overflow-auto">
                                {% for index, digit in component.segment_state %}
                                    <section class="segment text-center" data-digit="{{ index }}" data-value="{{ digit }}">
                                        <div data-segment="0"></div>
                                        <span data-segment="1"></span>
                                        <span data-segment="2"></span>
                                        <div data-segment="3"></div>
                                        <span data-segment="4"></span>
                                        <span data-segment="5"></span>
                                        <div data-segment="6"></div>
                                        <div class="dot" data-segment="7"></div>
                                    </section>
                                {% endfor %}
                            </div>


                            <div class="segment-text d-flex gap-2 align-items-center justify-content-center flex-wrap pt-2 pb-3 border-top">
                                {% for index, text in component.state %}
                                    <div class="d-flex align-items-center gap-1 bg-light border rounded p-1 shadow-sm">
                                        <span class="small fw-bold text-muted px-1" style="font-size: 0.8rem;">{{ index + 1 }}:</span>
                                        <button class="btn btn-outline-primary btn-sm px-2 fw-bold py-0" data-direction="prev" data-digit="{{ index }}">-</button>
                                        <input type="text" class="form-control form-control-sm bg-white text-dark border text-center fw-bold font-monospace p-1" style="width: 2rem; height: 1.8rem;" data-digit="{{ index }}" data-expected-value="{% if text == "" %} {% else %}{{ text }}{% endif %}" value="{{ text }}">
                                        <button class="btn btn-outline-primary btn-sm px-2 fw-bold py-0" data-direction="next" data-digit="{{ index }}">+</button>
                                        <button class="btn btn-outline-danger btn-sm px-1 py-0" data-direction="wipe" data-digit="{{ index }}" title="Smazat">🗑</button>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>


                        <div class="pt-3 border-top">
                            <label class="form-label small fw-bold text-muted mb-1">Režim znaků:</label>
                            <select class="cycle-category form-select form-select-sm bg-light text-dark border">
                                <option class="default" value="">Vyberte kategorii znaků</option>
                                <option value="digit">číslice</option>
                                <option value="hex">hexadecimální číslice</option>
                                <option value="letteropt">písmena</option>
                                <option value="lower">malá písmena</option>
                                <option value="upper">velká písmena</option>
                                <option value="letter">všechna písmena</option>
                            </select>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}