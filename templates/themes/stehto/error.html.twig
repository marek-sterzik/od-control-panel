{% extends theme_template("base.html.twig") %}

{% block body %}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 bg-white p-3 rounded border shadow-sm">
    <h2 class="fw-bold fs-4 m-0 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Chybový stav</h2>
    
    <div class="d-flex align-items-center gap-3">
        {% if user is defined and user.name %}
            <span class="text-muted small d-none d-sm-inline">Uživatel: <strong class="text-dark">{{ user.name }}</strong></span>
        {% endif %}
        <a href="/logout" class="btn btn-outline-danger btn-sm fw-semibold">
            <i class="bi bi-box-arrow-right me-1"></i>Odhlásit
        </a>
    </div>
</div>


<div class="row justify-content-center py-4 px-3">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card bg-white border border-danger shadow-sm p-4">
            <div class="card-body">
                <h1 class="display-4 text-danger mb-3"><i class="bi bi-exclamation-triangle-fill"></i></h1>
                <h3 class="card-title text-danger mb-3">Chyba: {{ errorCaption }}</h3>
                <p class="card-text text-muted mb-4">{{ errorMessage }}</p>
                
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    {% if retryUrl is not null %}
                        <a href="{{ retryUrl }}" class="btn btn-danger fw-bold px-4">Zkusit znovu</a>
                    {% endif %}
                    {% if backUrl is not null %}
                        <a href="{{ backUrl }}" class="btn btn-outline-secondary px-4">Zpět</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}