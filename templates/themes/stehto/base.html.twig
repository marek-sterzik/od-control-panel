<!DOCTYPE html>
<html lang="cs" data-bs-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Control Panel | Stehto{% endblock %}</title>
        

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}

        {% include "header.html.twig" %}

        {% block scripts %}
        {% endblock %}
    </head>
    <body class="bg-light text-dark min-vh-100 d-flex flex-column">


        <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm mb-4 py-3">
            <div class="container-fluid px-3 px-md-4">
                <span class="navbar-brand fw-bold text-primary fs-5">
                    <i class="bi bi-cpu me-2"></i>Control Panel
                </span>

                    <form action="{{ path("app.set-theme") }}" method="get" class="m-0">
                        <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                        <select class="form-select form-select-sm bg-light text-dark border submit-on-change" name="theme">
                            {% for theme in themes %}
                                <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>
                                    {{ theme.description }} ({{ theme.author }})
                                </option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
            </div>
        </nav>


        <main class="container-fluid px-2 px-md-4 flex-grow-1 pb-4">
            {% block body %}{% endblock %}
        </main>


        <footer class="text-center text-muted py-3 mt-auto small border-top bg-white">
            Tomáš Stehlík &bull; SPŠ Ostrov
        </footer>


        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>