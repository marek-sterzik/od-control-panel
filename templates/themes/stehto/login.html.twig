{% extends theme_template("base.html.twig") %}

{% block body %}
<div class="row justify-content-center align-items-center flex-grow-1 py-4">
    <div class="col-12 col-sm-9 col-md-7 col-lg-4 px-3">
        <div class="card bg-white border shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">


            <div class="text-center mb-4">
                <div class="mb-3">
                    <img src="{{ theme_asset('logo.png') }}" alt="Logo SPŠ Ostrov" style="max-height: 60px; width: auto;" class="img-fluid">
                </div>
                <h4 class="fw-bold text-dark mb-1">SPŠ Ostrov</h4>
                <p class="text-muted small mb-0">Hardware Control Panel</p>
            </div>
                
                <form method="post">
                    {% if loginError %}
                        <div class="alert alert-danger py-2 small rounded-3 text-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Chybné heslo nebo uživatel!
                        </div>
                    {% endif %}
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Uživatelský účet</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            <select name="username" class="form-select bg-light text-dark border-start-0 ps-0 shadow-none">
                                {% for username, name in users %}
                                    <option value="{{ username }}"{% if username == selectedUser %} selected="selected"{% endif %}>{{ name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold">Heslo</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                            <input type="password" name="password" class="form-control bg-light text-dark border-start-0 ps-0 shadow-none" placeholder="Zadejte heslo" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-3 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Přihlásit se
                    </button>
                </form>
            </div>
        </div>
        
        <div class="text-center mt-3 text-muted small">
            <span>Den otevřených dveří &bull; 2026</span>
        </div>
    </div>
</div>
{% endblock %}