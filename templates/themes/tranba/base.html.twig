<!DOCTYPE html>
<html lang="cs" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="dark">
        <title>{% block title %}Control panel{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}
        {% include "header.html.twig" %}
        {% block scripts %}
        {% endblock %}
    </head>
    <body>
        <nav class="navbar gaming-navbar" aria-label="Hlavní navigace">
            <div class="container-fluid gap-3">
                <a class="navbar-brand fw-bold" href="{{ app.request.basePath }}/">
                    CONTROL PANEL
                </a>
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <form action="{{ path('app.set-theme') }}" method="get">
                        <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                        <label for="theme-select" class="visually-hidden">Motiv vzhledu</label>
                        <select id="theme-select"
                                class="submit-on-change form-select form-select-sm"
                                name="theme">
                            {% for theme in themes %}
                                <option value="{{ theme.theme }}"
                                    {% if theme.active %}selected{% endif %}>
                                    {{ theme.description }} ({{ theme.author }})
                                </option>
                            {% endfor %}
                        </select>
                        <noscript>
                            <button type="submit" class="btn btn-sm btn-primary mt-1">Použít</button>
                        </noscript>
                    </form>
                    {% if user is defined and user is not null %}
                        <div class="userinfo">
                            <span{% if user.admin %} class="admin"{% endif %}>
                                {{ user.name }}
                            </span>
                            <a href="{{ path('app.logout') }}" class="logout-link">
                                Odhlásit se
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </nav>
        <main class="gaming-content">
            <h1 class="page-title">{% block page_title %}Control Hub{% endblock %}</h1>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
