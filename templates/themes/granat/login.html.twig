{% extends theme_template("base.html.twig") %}
{% block body %}
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-9 col-md-7 col-lg-5 col-xl-4">
                <section class="card border-info shadow-lg bg-dark bg-opacity-75 text-light">
                    <div class="card-body p-4">
                        <h2 class="card-title text-center mb-4">Přihlášení</h2>
                        {% if loginError %}
                            <div class="alert alert-danger" role="alert">
                                Chyba: přihlášení se nezdařilo, zadali jste správné heslo?
                            </div>
                        {% endif %}
                        <form method="post" class="d-grid gap-3">
                            <div>
                                <label for="username" class="form-label">Uživatel</label>
                                <select id="username" class="form-select" name="username">
                                    {% for username, name in users %}
                                        <option value="{{ username }}"{% if username == selectedUser %} selected="selected"{% endif %}>{{ name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div>
                                <label for="password" class="form-label">Heslo</label>
                                <input id="password" class="form-control" type="password" name="password" autocomplete="current-password">
                            </div>
                            <button class="btn btn-info fw-semibold" type="submit">Přihlásit se</button>
                        </form>
                    </div>
                </section>
            </div>
        </div>
    </main>
{% endblock %}
