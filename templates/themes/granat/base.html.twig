<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Control panel{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}
        {% include "header.html.twig" %}
        {% block scripts %}
        {% endblock %}
    </head>
    <body>
        <div class="themeselect">
            <form action="{{ path("app.set-theme") }}" method="get">
                <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                <select class="submit-on-change" name="theme">
                    {% for theme in themes %}
                        <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }} ({{ theme.author }})</option>
                    {% endfor %}
                </select>
            </form>
        </div>
        {% if user is not null %}
            <div class="userinfo">
                Přihlášený uživatel: <span{% if user.admin %} class="admin"{% endif %}>{{ user.name }}</span> (<a href="{{ path("app.logout") }}">odhlásit se</a>)
            </div>
        {% endif %}
        <div style="clear: both"></div>
        <h1>Cyberpunk</h1>
        {% block body %}{% endblock %}
    </body>
</html>
