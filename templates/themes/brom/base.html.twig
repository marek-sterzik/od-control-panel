<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Kontrolní panel{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}
        {% include "header.html.twig" %}
        {% block scripts %}
        {% endblock %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body>
        <style>
            .themeselect,
            body {
                background: #f3f5f9;
            }
            h1 {
                display: flex;
                justify-content: center;
                align-items: center;
                color: #00008b;
                font-style: italic;
                text-align: center;
            }
            .userinfo {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                margin: 10px 25px;
                font-size: 14px;
            }
            .themeselect {
                margin-top: 18px;
                margin-bottom: 10px;
            }
            .themeselect form {
                margin: 0;
            }
            .themeselect select {
                min-width: 220px;
                padding: 9px 14px;
                border: 1px solid #d5dce5;
                border-radius: 10px;
                background: #fff;
                color: #344054;
                font-size: 14px;
                font-weight: 500;
                cursor: pointer;
                box-shadow: 0 2px 6px rgba(0,0,0,.04);
                transition: .2s ease;
            }
            .themeselect select:hover {
                border-color: #86b7fe;
            }
            .themeselect select:focus {
                outline: none;
                border-color: #0d6efd;
                box-shadow: 0 0 0 3px rgba(13,110,253,.15);
            }
            .userinfo {
                width: fit-content;
                margin-left: auto;
                padding: 10px 16px;
                gap: 5px;
                background: #fff;
                border: 1px solid #e5eaf0;
                border-radius: 10px;
                color: #667085;
                box-shadow: 0 2px 8px rgba(0,0,0,.04);
            }
            .userinfo span {
                color: #344054;
                font-weight: 700;
            }
            .userinfo span.admin {
                color: #0d6efd;
            }
            .userinfo a {
                margin-left: 5px;
                padding: 5px 10px;
                border-radius: 7px;
                background: #fff1f0;
                color: #dc3545;
                text-decoration: none;
                font-weight: 600;
                transition: .2s ease;
            }
            .userinfo a:hover {
                background: #dc3545;
                color: #fff;
            }
            @media (max-width: 576px) {
                .themeselect,
                .userinfo {
                    margin-right: 12px;
                    margin-left: 12px;
                }

                .themeselect select {
                    min-width: 190px;
                    max-width: 100%;
                }

                .userinfo {
                    flex-wrap: wrap;
                    font-size: 12px;
                }
            }
        </style>

        <div class="themeselect">
            <form action="{{ path("app.set-theme") }}" method="get">
                <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                <select class="submit-on-change" name="theme">
                    {% for theme in themes %}
                        <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }} ({{ theme.author }})</option>
                    {% endfor %}
                </select>
            </form>
        </div>
        {% if user is not null %}
            <div class="userinfo">
                Přihlášený uživatel: <span{% if user.admin %} class="admin"{% endif %}>{{ user.name }}</span> (<a href="{{ path("app.logout") }}">odhlásit se</a>)
            </div>
        {% endif %}
        <div style="clear: both"></div>
        <h1>Kontrolní panel (VB)</h1>
        {% block body %}{% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
