{% extends theme_template("base.html.twig") %}

{% block scripts %}
        <script src="{{ theme_asset("main.js") }}"></script>
{% endblock %}

{% block body %}
    
    <style>
        body {
            background: #f3f5f9;
            color: #263238;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        }
        body > h2 {
            text-align: center;
            font-size: 1.8rem;
            font-weight: 800;
            color: #263b53;
            margin: 30px 0;
        }
        body > div[data-metrix-id] {
            display: inline-flex;
            vertical-align: top;
            flex-direction: column;
            width: calc(50% - 35px);
            min-width: 280px;
            max-width: 550px;
            margin: 12px;
            padding: 24px;
            background: #ffffff;
            border: 1px solid #e1e7ef;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(30, 50, 80, 0.06);
            transition: all 0.2s ease;
        }
        body > div[data-metrix-id]:hover {
            box-shadow: 0 8px 25px rgba(30, 50, 80, 0.12);
            transform: translateY(-3px);
        }
        body {
            text-align: center;
        }
        [data-metrix-id] {
            text-align: left;
        }
        h2 {
            font-size: 1.3rem;
            font-weight: 700;
            color: #263b53;
            margin-bottom: 18px;
        }
        [data-metrix-id] h2 {
            font-size: 1.1rem;
            margin-top: 15px;
            padding-bottom: 8px;
            border-bottom: 1px solid #edf0f5;
        }
        label {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            margin: 8px 0;
            color: #344054;
        }
        input[type="checkbox"] {
            appearance: none;
            width: 23px;
            height: 23px;
            min-width: 23px;
            border: 2px solid #b8c3d1;
            border-radius: 7px;
            background: #fff;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }
        input[type="checkbox"]:checked {
            background: ##00008b;
            border-color: ##00008b;
        }
        input[type="checkbox"]:checked::after {
            content: "X";
            color: white;
            font-size: 16px;
            font-weight: bold;
            position: absolute;
            left: 3px;
            top: -1px;
        }
        input[type="checkbox"]:hover {
            border-color: #00008b;
        }
        .slave {
            margin: 14px 0 0 20px;
            padding: 12px 15px;
            background: #f0f5ff;
            border-radius: 10px;
            border-left: 4px solid #00008b;
        }
        label::before {
            content: "●";
            font-size: 19px;
            color: #00008b;
            margin-right: 2px;
        }
        .slave label::before {
            content: " I/0";
            color: #FF0000;
        }
        .segments {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 18px;
            padding: 22px;
            background: #18212e;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        .cycle-category {
            display: block;
            width: 100%;
            padding: 11px 14px;
            border: 1px solid #ced4da;
            border-radius: 9px;
            background: #fff;
            font-size: 0.95rem;
            margin-bottom: 12px;
        }
        [data-metrix-id] p {
            color: #6c757d;
            font-size: 0.9rem;
            margin: 10px 0 16px;
        }
        .segment-text {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            padding: 15px;
            background: #f5f7fb;
            border-radius: 10px;
        }
        .segment-text button {
            min-width: 40px;
            height: 40px;
            border: none;
            border-radius: 8px;
            background: #00008b;
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s ease;
        }
        .segment-text button:hover {
            background: #00008b;
            transform: translateY(-2px);
        }
        .segment-text button[data-direction="wipe"] {
            background: #dc3545;
        }
        .segment-text button[data-direction="wipe"]:hover {
            background: #bb2d3b;
        }
        .segment-text input[type="text"] {
            width: 65px;
            height: 40px;
            text-align: center;
            font-size: 1.1rem;
            font-weight: 600;
            border: 1px solid #ced4da;
            border-radius: 8px;
        }
        .segment-text input:focus,
        .cycle-category:focus {
            outline: none;
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.2);
        }
        @media (max-width: 700px) {
            body > div[data-metrix-id] {
                width: calc(100% - 24px);
                min-width: 0;
                margin: 10px 0;
            }
        }
        @media (min-width: 1200px) {
            body > div[data-metrix-id] {
                width: calc(33.333% - 35px);
            }
        }
    </style>

    <h2>Ovládání</h2>
    {% for component in controls %}
        <div data-metrix-id="{{ component.id }}">
            {% if component.type == "switch" %}
                <label>
                    <input type="checkbox" data-part="state" {% if component.state %}checked="checked"{% endif %}>
                    {{ component.caption }}
                </label>
                {% if "blink" in component.parts %}
                    <div class="slave">
                        <label>
                            <input type="checkbox" data-part="blink" {% if component.blink %}checked="checked"{% endif %}>
                            blikání
                        </label>
                    </div>
                {% endif %}
            {% elseif component.type == "segment" %}
                <h2>{{component.caption}}</h2>
                <h2>Segmenty</h2>
                <div class="segments">
                    {% for index, digit in component.segment_state %}
                        <section class="segment" data-digit="{{ index }}" data-value="{{ digit }}">
                            <div data-segment="0"></div>
                            <span data-segment="1"></span>
                            <span data-segment="2"></span>
                            <div data-segment="3"></div>
                            <span data-segment="4"></span>
                            <span data-segment="5"></span>
                            <div data-segment="6"></div>
                            <div class="dot" data-segment="7"></div>
                        </section>
                    {% endfor %}
                </div>
                <h2>Textové vyjádření</h2>
                <select class="cycle-category">
                    <option class="default" value="">Vyberte kategorii znaků</option>
                    <option value="digit">číslice (1234)</option>
                    <option value="hex">hexadecimální číslice (abcdef)</option>
                    <option value="letteropt">písmena (ABCD/abcd)</option>
                    <option value="lower">malá písmena (abcd)</option>
                    <option value="upper">velká písmena (ABCD)</option>
                    <option value="letter">všechna písmena(A-Z)</option>
                </select>
                <p>Kategorie znaků se uplatní při stisku tlačítek "+" a "-".</p>
                <div class="segment-text">
                    {% for index, text in component.state %}
                        <button data-direction="prev" data-digit="{{ index }}">-</button>
                        <input type="text" data-digit="{{ index }}" data-expected-value="{% if text == "" %} {% else %}{{ text }}{% endif %}" value="{{ text }}">
                        <button data-direction="wipe" data-digit="{{ index }}">🗑</button>
                        <button data-direction="next" data-digit="{{ index }}">+</button>
                    {% endfor %}
                </div>
            {% else %}
                unknown component: {{ component.type }}
            {% endif %}
        </div>
    {% endfor %}
{% endblock %}
