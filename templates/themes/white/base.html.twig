<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Control panel{% endblock %}</title>
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
            
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}
        {% include "header.html.twig" %}
        {% block scripts %}
        <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
        {% endblock %}
    </head>
    <body class="bg-secondary bg-opacity-10 min-vh-100">
        
        <div class="bg-dark text-white px-3 px-md-4 py-3 shadow border-bottom border-primary border-4 mb-3 mb-md-5">
            <div class="container">
                <div class="themeselect float-md-start mb-2 mb-md-0">
                    <form action="{{ path("app.set-theme") }}" method="get" class="m-0">
                        <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                        <select class="submit-on-change form-select form-select-sm bg-secondary text-white border-0 shadow-sm w-100" name="theme">
                            {% for theme in themes %}
                                <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }} ({{ theme.author }})</option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
                {% if user is not null %}
                    <div class="userinfo float-md-end mt-1 small text-center text-md-end">
                        Přihlášený uživatel: <span{% if user.admin %} class="admin badge bg-warning text-dark ms-1"{% else %} class="fw-bold text-info ms-1"{% endif %}>{{ user.name }}</span> (<a href="{{ path("app.logout") }}" class="link-danger text-decoration-none fw-semibold">odhlásit se</a>)
                    </div>
                {% endif %}
                <div style="clear: both"></div>
            </div>
        </div>

        <div class="container pb-4 pb-md-5 px-2 px- sm-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-5 bg-white">
                <h1 class="display-6 fw-bold text-primary border-bottom pb-3 mb-4">White</h1>
                {% block body %}{% endblock %}
            </div>
        </div>

    </body>
</html>