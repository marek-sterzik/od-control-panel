{% extends theme_template("base.html.twig") %}

{% block body %}
    <div class="abyssal-window login-window">
        <h2>Přihlášení</h2>
        <form method="post" class="login-form">
            {% if loginError %}
                <div class="login-error">
                    Chyba: přihlášení se nezdařilo, zadali jste správné heslo?
                </div>
            {% endif %}
            
            <div class="form-group">
                <label for="username">Uživatel</label>
                <select name="username" id="username" class="cycle-category">
                    {% for username, name in users %}
                        <option value="{{ username }}"{% if username == selectedUser %} selected="selected"{% endif %}>{{ name }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="form-group">
                <label for="password">Heslo</label>
                <input type="password" name="password" id="password" class="login-input" placeholder="Zadejte heslo">
            </div>
            
            <div class="form-group">
                <button type="submit" class="login-button">Přihlásit se</button>
            </div>
        </form>
    </div>
{% endblock %}