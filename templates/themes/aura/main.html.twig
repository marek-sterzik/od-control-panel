{% extends theme_template("base.html.twig") %}

{% block scripts %}
    <script src="{{ theme_asset("main.js") }}"></script>
{% endblock %}

{% block body %}
<div class="container my-4">
    <h2 class="mb-4">Ovládání</h2>

    {% for component in controls %}
        <div class="card mb-3 shadow-sm" data-metrix-id="{{ component.id }}">
            <div class="card-body">
                {% if component.type == "switch" %}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="switch-{{ component.id }}" data-part="state" {% if component.state %}checked="checked"{% endif %}>
                        <label class="form-check-label fw-bold" for="switch-{{ component.id }}">
                            {{ component.caption }}
                        </label>
                    </div>

                    {% if "blink" in component.parts %}
                        <div class="form-check ms-4 mt-2">
                            <input class="form-check-input" type="checkbox" id="blink-{{ component.id }}" data-part="blink" {% if component.blink %}checked="checked"{% endif %}>
                            <label class="form-check-label text-muted" for="blink-{{ component.id }}">
                                blikání
                            </label>
                        </div>
                    {% endif %}

                {% elseif component.type == "segment" %}
                    <h4 class="card-title mb-3">{{ component.caption }}</h4>
                    
                    <h6 class="text-muted mb-2">Segmenty</h6>
                    <div class="segments d-flex flex-wrap gap-3 mb-4 p-2 bg-light rounded">
                        {% for index, digit in component.segment_state %}
                            <section class="segment" data-digit="{{ index }}" data-value="{{ digit }}">
                                <div data-segment="0"></div>
                                <span data-segment="1"></span>
                                <span data-segment="2"></span>
                                <div data-segment="3"></div>
                                <span data-segment="4"></span>
                                <span data-segment="5"></span>
                                <div data-segment="6"></div>
                                <div class="dot" data-segment="7"></div>
                            </section>
                        {% endfor %}
                    </div>

                    <h6 class="text-muted mb-2">Textové vyjádření</h6>
                    <div class="mb-3">
                        <select class="form-select cycle-category mb-1">
                            <option class="default" value="">Vyberte kategorii znaků</option>
                            <option value="digit">číslice</option>
                            <option value="hex">hexadecimální číslice</option>
                            <option value="letteropt">písmena</option>
                            <option value="lower">malá písmena</option>
                            <option value="upper">velká písmena</option>
                            <option value="letter">všechna písmena</option>
                        </select>
                        <div class="form-text">Kategorie znaků se uplatní při stisku tlačítek "+" a "-".</div>
                    </div>

                    <div class="segment-text d-flex flex-wrap align-items-center gap-2">
                        {% for index, text in component.state %}
                            <div class="btn-group shadow-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2" data-direction="prev" data-digit="{{ index }}">-</button>
                                <input type="text" class="form-control form-control-sm text-center" style="max-width: 50px;" data-digit="{{ index }}" data-expected-value="{% if text == "" %} {% else %}{{ text }}{% endif %}" value="{{ text }}">
                                <button type="button" class="btn btn-outline-danger btn-sm px-2" data-direction="wipe" data-digit="{{ index }}">🗑</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2" data-direction="next" data-digit="{{ index }}">+</button>
                            </div>
                        {% endfor %}
                    </div>

                {% else %}
                    <div class="alert alert-warning mb-0" role="alert">
                        unknown component: {{ component.type }}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}