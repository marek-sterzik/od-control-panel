{% extends "themes/ugly/base.html.twig" %}

{% block scripts %}
        <script src="{{ theme_asset("main.js") }}"></script>
{% endblock %}

{% block body %}
    <div>
        Přihlášený uživatel: {{ app.user.userIdentifier }} (<a href="{{ path("app.logout") }}">odhlásit se</a>)
    </div>
    {{ theme_asset("abc") }}
    <h2>Ovládání</h2>
    {% for component in controls %}
        <div data-metrix-id="{{ component.id }}">
            <label>
                <input type="checkbox" {% if component.state %}checked="checked"{% endif %}>
                {{ component.caption }}
            </label>
        </div>
    {% endfor %}
{% endblock %}
