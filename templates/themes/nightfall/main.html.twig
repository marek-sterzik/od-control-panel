
{% extends theme_template("base.html.twig") %}

{% block scripts %}
    <script src="{{ theme_asset("main.js") }}"></script>
{% endblock %}

{% block stylesheet %}
    <link href="{{ theme_asset('style_main.css') }}" rel="stylesheet">
{% endblock %}


{% block body %}

<main class="dashboard">

    <header class="page-header">
        <h1>Ovládání</h1>
        <p>Správa připojených komponent</p>
    </header>

    {% for component in controls %}

        <div class="control-card" data-metrix-id="{{ component.id }}">

            {% if component.type == "switch" %}

                <div class="card-header">
                    <h2>{{ component.caption }}</h2>
                    <span class="status-label">SWITCH</span>
                </div>

                <label class="switch-label">
                    <input type="checkbox" data-part="state"
                        {% if component.state %}checked="checked"{% endif %}>
                    <span>{{ component.caption }}</span>
                </label>

                {% if "blink" in component.parts %}
                    <div class="slave">
                        <label>
                            <input type="checkbox" data-part="blink"
                                {% if component.blink %}checked="checked"{% endif %}>
                            <span>Blikání</span>
                        </label>
                    </div>
                {% endif %}

            {% elseif component.type == "segment" %}

                <div class="card-header">
                    <h2>{{ component.caption }}</h2>
                    <span class="status-label">Segmentový displej</span>
                </div>

                <h3>Segmentový displej</h3>

                <div class="segments">
                    {% for index, digit in component.segment_state %}
                        <section class="segment"
                            data-digit="{{ index }}"
                            data-value="{{ digit }}">
                            <div data-segment="0"></div>
                            <span data-segment="1"></span>
                            <span data-segment="2"></span>
                            <div data-segment="3"></div>
                            <span data-segment="4"></span>
                            <span data-segment="5"></span>
                            <div data-segment="6"></div>
                            <div class="dot" data-segment="7"></div>
                        </section>
                    {% endfor %}
                </div>

                <h3>Textové vyjádření</h3>

                <select class="cycle-category">
                    <option class="default" value="">Vyberte kategorii znaků</option>
                    <option value="digit">číslice</option>
                    <option value="hex">hexadecimální číslice</option>
                    <option value="letteropt">písmena</option>
                    <option value="lower">malá písmena</option>
                    <option value="upper">velká písmena</option>
                    <option value="letter">všechna písmena</option>
                </select>

                <p>Kategorie znaků se uplatní při stisku tlačítek "+" a "-".</p>

                <div class="segment-text">
                    {% for index, text in component.state %}
                        <button type="button" data-direction="prev" data-digit="{{ index }}">-</button>
                        <input type="text" data-digit="{{ index }}" data-expected-value="{{ text }}" value="{{ text }}">
                        <button type="button" data-direction="wipe" data-digit="{{ index }}">🗑</button>
                        <button type="button" data-direction="next" data-digit="{{ index }}">+</button>
                    {% endfor %}
                </div>

            {% else %}

                unknown component: {{ component.type }}

            {% endif %}

        </div>

    {% endfor %}

</main>

{% endblock %}
