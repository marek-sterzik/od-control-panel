<!DOCTYPE html>
<html>
    <head>
        {% include "header.html.twig" %}
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Control Panel</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        {% block stylesheet %}{% endblock %}
    </head>

    <body>
    <header class="site-header">
        <form class="theme-form" action="{{ path("app.set-theme") }}" method="get">
            <input type="hidden" name="back" value="{{ app.request.requesturi }}">
            <label class="visually-hidden" for="themeSelect">Vybrat motiv</label>
            <select id="themeSelect" name="theme" class="submit-on-change form-select custom-select" aria-label="Vybrat motiv">
                {% for theme in themes %}
                    <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }} ({{ theme.author }})</option>
                {% endfor %}
            </select>
        </form>
        {% if user is not null %}
            <div class="userinfo">
                <span class="user-caption">Přihlášený uživatel:</span>
                <span{% if user.admin %} class="admin"{% endif %}>{{ user.name }}</span>
                <a class="logout-link" href="{{ path("app.logout") }}">Odhlásit se</a>
            </div>
        {% endif %}
    </header>
    {% block body %}{% endblock %}
    {% block scripts %}{% endblock %}
    </body>
</html>