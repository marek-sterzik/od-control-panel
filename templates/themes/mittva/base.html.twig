<!DOCTYPE html>

<html lang="cs">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}Control{% endblock %}</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

        <link rel="stylesheet" href="{{ theme_asset('style.css') }}">

        {% include "header.html.twig" %}

        {% block scripts %}
        
        {% endblock %}
    </head>

    <body>

        <nav class="navbar navbar-dark">

            <div class="container">

                <a class="navbar-brand fw-bold" href="#">
                    Control
                </a>

                <div class="d-flex align-items-center gap-3">
                    
                    {% if user is not null %}

                        <div class="userinfo">
                            {{ user.name }}

                            (<a href="{{ path("app.logout") }}">Odhlásit se</a>)
                        </div>
                    {% endif %}

                    <form action="{{ path("app.set-theme") }}" method="get">
                        <input type="hidden" name="back" value="{{ app.request.requesturi }}">

                        <select class="form-select form-select-sm submit-on-change" name="theme">

                            {% for theme in themes %}

                                <option value="{{ theme.theme }}"
                                    {% if theme.active %}selected="selected"{% endif %}>
                                    {{ theme.description }}
                                </option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
            </div>
        </nav>

        <main class="container py-4">
            
            {% block body %}

            {% endblock %}
        </main>

        <footer class="text-center py-3">
            Control Panel
        </footer>
    </body>
</html>