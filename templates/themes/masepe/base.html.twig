<!DOCTYPE html>
<html lang="cs" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b1017">
    <title>{% block title %}Ovládací panel{% endblock %} – SPŠ Ostrov</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
    {% include "header.html.twig" %}
    {% block head %}{% endblock %}
</head>
<body>
    <a class="skip-link" href="#main-content">Přeskočit na obsah</a>
    <div class="app-frame">
        <header class="site-header">
            <div class="container-xl site-header-inner">
                <a class="brand" href="{{ path('main') }}" aria-label="SPŠ Ostrov – hlavní stránka">
                    <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                    <span class="brand-copy">
                        <strong>SPŠ Ostrov</strong>
                        <span>Řídicí systém</span>
                    </span>
                </a>

                <div class="header-tools">
                    {% if user is not null %}
                        <div class="user-chip">
                            <span class="user-avatar" aria-hidden="true">{{ user.name|slice(0, 1)|upper }}</span>
                            <span class="user-copy">
                                <span class="user-label">Přihlášen{% if user.admin %}ý správce{% else %}ý uživatel{% endif %}</span>
                                <strong>{{ user.name }}</strong>
                            </span>
                            <a class="logout-link" href="{{ path('app.logout') }}">Odhlásit</a>
                        </div>
                    {% endif %}
                    <form class="theme-picker" action="{{ path('app.set-theme') }}" method="get">
                        <label for="theme-select">Vzhled</label>
                        <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                        <select id="theme-select" class="form-select form-select-sm submit-on-change" name="theme" aria-label="Vybrat vzhled">
                            {% for theme in themes %}
                                <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }}</option>
                            {% endfor %}
                        </select>
                        <noscript><button class="btn btn-sm btn-outline-light" type="submit">Použít</button></noscript>
                    </form>
                </div>
            </div>
        </header>

        <main id="main-content" class="container-xl page-content">
            {% block content %}{% endblock %}
        </main>

        <footer class="site-footer container-xl">
            <span>SPŠ Ostrov <span aria-hidden="true">·</span> Ovládací panel</span>
            <span class="footer-status"><span class="status-dot" aria-hidden="true"></span> Rozhraní připraveno</span>
        </footer>
    </div>
    {% block scripts %}{% endblock %}
</body>
</html>
