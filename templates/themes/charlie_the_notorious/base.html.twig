<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Control panel{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}
        {% include "header.html.twig" %}
        {% block scripts %}
        {% endblock %}
    </head>
    <body>
        <div class="ghost-patrol" aria-hidden="true">
            <span class="ghost ghost-cyan"></span>
            <span class="ghost ghost-pink"></span>
            <span class="ghost ghost-yellow"></span>
            <span class="ghost ghost-violet"></span>
        </div>
        <div class="themeselect" style="position: fixed; top: .75rem; right: .75rem; z-index: 1000;">
            <form action="{{ path("app.set-theme") }}" method="get">
                <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                <select class="submit-on-change" name="theme">
                    {% for theme in themes %}
                        <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }}</option>
                    {% endfor %}
                </select>
            </form>
        </div>
        {% if user is not null %}
            <div class="userinfo">
                Přihlášený uživatel: <span{% if user.admin %} class="admin"{% endif %}>{{ user.name }}</span> (<a href="{{ path("app.logout") }}">odhlásit se</a>)
            </div>
        {% endif %}
        <div style="clear: both"></div>
        <h1>Charlie_The_Notorious</h1>
        {% block body %}{% endblock %}
    </body>
</html>
