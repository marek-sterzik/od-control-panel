<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Control panel{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}
        {% include "header.html.twig" %}
        {% block scripts %}
        {% endblock %}
    </head>
    <body>
        <main class="container app-shell py-4 py-md-5">
            <header class="topbar d-flex flex-column flex-sm-row align-items-end align-items-sm-center justify-content-end gap-3 mb-4">
                {% if user is not null %}
                    <div class="userinfo text-end">
                        Přihlášený uživatel: <span{% if user.admin %} class="admin"{% endif %}>{{ user.name }}</span>
                        <a class="logout-link" href="{{ path("app.logout") }}">Odhlásit se</a>
                    </div>
                {% endif %}
                <div class="themeselect">
                    <form action="{{ path("app.set-theme") }}" method="get">
                        <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                        <select class="submit-on-change form-select" name="theme" aria-label="Vybrat vzhled">
                            {% for theme in themes %}
                                <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }} ({{ theme.author }})</option>
                            {% endfor %}
                        </select>
                        <div class="theme-picker" hidden>
                            <button class="theme-picker-toggle" type="button" aria-haspopup="listbox" aria-expanded="false">
                                {% for theme in themes %}{% if theme.active %}{{ theme.description }} ({{ theme.author }}){% endif %}{% endfor %}
                            </button>
                            <div class="theme-picker-options" role="listbox" hidden>
                                {% for theme in themes %}
                                    <button class="theme-picker-option" type="button" role="option" data-theme="{{ theme.theme }}" aria-selected="{% if theme.active %}true{% else %}false{% endif %}">{{ theme.description }} ({{ theme.author }})</button>
                                {% endfor %}
                            </div>
                        </div>
                    </form>
                </div>
            </header>
            <h1 class="text-center mb-4">Simple Darkmode</h1>
            {% block body %}{% endblock %}
        </main>
        <script>
            document.querySelectorAll(".theme-picker").forEach(function(picker) {
                const form = picker.closest("form");
                const select = form.querySelector("select[name='theme']");
                const toggle = picker.querySelector(".theme-picker-toggle");
                const options = picker.querySelector(".theme-picker-options");

                select.hidden = true;
                picker.hidden = false;

                toggle.addEventListener("click", function() {
                    options.hidden = !options.hidden;
                    toggle.setAttribute("aria-expanded", String(!options.hidden));
                });

                picker.querySelectorAll(".theme-picker-option").forEach(function(option) {
                    option.addEventListener("click", function() {
                        select.value = option.dataset.theme;
                        select.dispatchEvent(new Event("change", { bubbles: true }));
                    });
                });

                document.addEventListener("click", function(event) {
                    if (!picker.contains(event.target)) {
                        options.hidden = true;
                        toggle.setAttribute("aria-expanded", "false");
                    }
                });
            });
        </script>
    </body>
</html>
