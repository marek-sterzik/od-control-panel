{% extends theme_template("base.html.twig") %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ theme_asset('login.css') }}">
{% endblock %}

{% block body %}
    <div class="login-wrapper">
        <h2>Přihlášení</h2>
        <form class="login-form" method="post">
            {% if loginError %}
                <div class="login-error">
                    Chyba: přihlášení se nezdařilo, zadali jste správné heslo?
                </div>
            {% endif %}
            <div class="form-group">
                <label for="username-select">Uživatel</label>
                <select id="username-select" name="username" class="form-select">
                    {% for username, name in users %}
                        <option value="{{ username }}"{% if username == selectedUser %} selected="selected"{% endif %}>{{ name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label for="password-input">Heslo</label>
                <input id="password-input" type="password" name="password">
            </div>
            <button type="submit">Přihlásit se</button>
        </form>
    </div>
{% endblock %}