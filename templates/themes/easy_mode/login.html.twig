<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Přihlášení do systému</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Propojení s tvým stylem -->
    <link href="{{ theme_asset('style2.css') }}" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center min-vh-100">
 
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-4">
                        <h4 class="text-center mb-4">Přihlášení</h4>
 
                        {% if loginError %}
                            <div class="alert alert-danger" role="alert">
                                Neplatné přihlašovací údaje. Zkuste to prosím znovu.
                            </div>
                        {% endif %}
 
                        <form action="" method="post">
                            <div class="mb-3">
                                <label for="username" class="form-label">Uživatel</label>
                                <select class="form-select" id="username" name="username" required>
                                    <option value="" selected disabled>Vyberte uživatele</option>
                                    <option value="user">User</option>
                                    <option value="administrator">Administrator</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Heslo</label>
                                <input type="password" class="form-control" id="password" name="password" required>
                            </div>
                            
                            <button type="submit" class="btn btn-primary w-100">Přihlásit se</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
 
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>