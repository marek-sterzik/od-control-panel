<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Control panel{% endblock %}</title>
        
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style2.css') }}">
        {% endblock %}
        
        {# Tady vkládáš svůj nový čistý header #}
        {% include "header.html.twig" %}
        {% block scripts %}
            {# Zde se načítá tvůj skript ze složky easy_mode #}
            <script id="main2-script" data-page="{{ pageId }}" src="{{ theme_asset('main2.js') }}"></script>
            <script>
                var jQuery = metrix.jQuery
                var $ = metrix.jQuery
            </script>

            {% if controls is defined and controls is not null and pageId == "main" %}
                <script>
                    metrix.backend.provideState({{ controls|json_encode|raw }}, true)
                </script>
            {% endif %}
        {% endblock %}
    </head>
    <body>
        <div class="themeselect">
            <form action="{{ path("app.set-theme") }}" method="get">
                <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                <select class="submit-on-change" name="theme">
                    {% for theme in themes %}
                        <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>{{ theme.description }} ({{ theme.author }})</option>
                    {% endfor %}
                </select>
            </form>
        </div>
        {% if user is not null %}
            <div class="userinfo">
                Přihlášený uživatel: <span{% if user.admin %} class="admin"{% endif %}>{{ user.name }}</span> (<a href="{{ path("app.logout") }}">odhlásit se</a>)
            </div>
        {% endif %}
        <div style="clear: both"></div>
        <h1>Easy mode</h1>
        
        {% block body %}{% endblock %}
    </body>
</html>