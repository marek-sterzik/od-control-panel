{% extends theme_template("base.html.twig") %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ theme_asset('style2.css') }}">
{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8">
                <h2 class="mb-4 text-center">Ovládací panel</h2>

                <div class="card shadow-sm border-0 rounded-3">
                    <ul class="list-group list-group-flush rounded-3">
                        {% for control in controls %}
                            <li class="list-group-item p-3">
                                <div class="component w-100" data-component-id="{{ control.id }}">

                                    {% if control.type == 'switch' %}
                                        {% set isOn = control.state is defined and control.state ? true : false %}
                                        {% set isBlink = control.blink is defined and control.blink ? true : false %}
                                        <div class="d-flex flex-wrap justify-content-between align-items-center w-100 gap-2">
                                            <div>
                                                <h6 class="mb-0">{{ control.caption }}</h6>
                                            </div>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="indicator-lamp mt-1 {% if isOn %}{% if control.id == 'blue' %}active-blue{% elseif control.id == 'red' %}active-red{% elseif control.id == 'green' %}active-green{% elseif control.id == 'yellow' %}active-yellow{% else %}active-default{% endif %}{% endif %} {% if isOn and isBlink %}blink{% endif %}" data-switch-id="{{ control.id }}"></div>

                                                <button type="button" class="btn btn-sm {% if isBlink %}btn-warning active{% else %}btn-outline-secondary{% endif %} blink-toggle" data-part="{{ control.id }}" data-blink="{{ isBlink ? '1' : '0' }}">
                                                    Blikání
                                                </button>

                                                <div class="form-check form-switch fs-4 mb-0">
                                                    <input class="form-check-input switch-input" type="checkbox" role="switch" id="switch-{{ control.id }}" name="switch-{{ control.id }}" data-part="{{ control.id }}" {% if isOn %}checked{% endif %}>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}

                                    {% if control.type == 'segment' %}
                                        {% set digitCount = control.state is iterable and control.state|length > 0 ? control.state|length : 2 %}
                                        <div class="segment-widget w-100" data-id="{{ control.id }}">
                                            <div class="mb-2">
                                                <h6 class="mb-0">{{ control.caption }}</h6>
                                            </div>

                                            <div class="d-flex flex-wrap justify-content-center align-items-stretch mt-3 mb-3" style="gap: 15px;">
                                                {% for i in 0..(digitCount - 1) %}
                                                    {% set segVal = control.segment_state[i] is defined ? control.segment_state[i] : '00000000' %}
                                                    {% set charVal = control.state[i] is defined ? control.state[i] : '' %}
                                                    <div class="single-digit-container text-center d-flex flex-column align-items-center justify-content-between">
                                                        <section class="segment" data-digit="{{ i }}" data-value="{{ segVal }}">
                                                            <div></div>
                                                            <div>
                                                                <span data-segment="5"></span>
                                                                <span data-segment="1"></span>
                                                            </div>
                                                            <div data-segment="6"></div>
                                                            <div>
                                                                <span data-segment="4"></span>
                                                                <span data-segment="2"></span>
                                                            </div>
                                                            <div data-segment="3"></div>
                                                            <div class="dot" data-segment="7"></div>
                                                        </section>

                                                        <div class="mt-3">
                                                            <div class="d-flex justify-content-center align-items-center gap-1 mb-2">
                                                                <button type="button" class="btn btn-sm btn-outline-primary px-2 py-1" data-direction="prev" data-digit="{{ i }}">-</button>
                                                                <span class="small text-muted fw-bold" style="font-size: 0.8rem;">Znak</span>
                                                                <button type="button" class="btn btn-sm btn-outline-primary px-2 py-1" data-direction="next" data-digit="{{ i }}">+</button>
                                                            </div>
                                                            <div class="segment-text d-flex justify-content-center">
                                                                <input type="text" id="seg-{{ control.id }}-{{ i }}" name="seg-{{ control.id }}-{{ i }}" value="{{ charVal }}" data-digit="{{ i }}" autocomplete="off" class="form-control text-center p-0" style="width: 2.5em; height: 1.8em; display: inline-block;">
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>

                                            <div class="text-center mt-2">
                                                <button type="button" class="btn btn-sm btn-outline-danger text-uppercase" data-direction="wipe" data-digit="0" style="width: auto !important; height: auto !important; padding: 0.25rem 0.75rem; font-size: 0.75rem;">Smazat vše</button>
                                            </div>
                                        </div>
                                    {% endif %}

                                </div>
                            </li>
                        {% else %}
                            <li class="list-group-item p-3 text-center text-muted">
                                Žádné ovládací prvky nebyly nalezeny.
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}