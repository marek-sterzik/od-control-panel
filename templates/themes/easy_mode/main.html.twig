<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ovládací panel</title>
    
    {% if metaRefresh is defined and metaRefresh is not null %}
        <meta http-equiv="refresh" content="{{ metaRefresh }}">
    {% endif %}

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ theme_asset('style2.css') }}" rel="stylesheet">
</head>
<body class="bg-light py-5">

    <script id="main-script" data-page="{{ pageId }}" src="{{ asset('js/main.js') }}"></script>
    <script>
        var jQuery = metrix.jQuery
        var $ = metrix.jQuery
    </script>

    {% if controls is defined and controls is not null and pageId == "main" %}
        <script>
            metrix.backend.provideState({{ controls|json_encode|raw }}, true)
        </script>
    {% endif %}

    <div class="container">
        <div class="row justify-content-center mb-2">
            <div class="col-md-8 col-lg-6 d-flex justify-content-end">
                <div class="themeselect"></div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <h2 class="mb-4 text-center">Ovládací panel</h2>
                
                <div class="card shadow-sm border-0 rounded-3">
                    <ul class="list-group list-group-flush rounded-3">
                        {% for control in controls %}
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3 flex-wrap">
                                <div class="w-100 d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <h6 class="mb-0">{{ control.caption }}</h6>
                                    </div>
                                    
                                    {% if control.type == 'switch' %}
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="indicator-lamp mt-1 {% if control.state %}{% if control.id == 'blue' %}active-blue{% elseif control.id == 'red' %}active-red{% elseif control.id == 'green' %}active-green{% elseif control.id == 'yellow' %}active-yellow{% else %}active-default{% endif %}{% endif %}" data-switch-id="{{ control.id }}"></div>
                                            
                                            <div class="form-check form-switch fs-4 mb-0">
                                                <input class="form-check-input switch-input" type="checkbox" role="switch" id="{{ control.id }}" data-part="{{ control.id }}" {% if control.state %}checked{% endif %}>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>

                                {% if control.type == 'segment' %}
                                    <div class="segment-widget w-100 mt-3 border-top pt-3" data-id="{{ control.id }}">
                                        <div class="d-flex justify-content-center align-items-stretch mb-3" style="gap: 15px;">
                                            
                                            {% for i in range(0, 1) %}
                                                <div class="single-digit-container text-center d-flex flex-column justify-content-between">
                                                    <section class="segment" data-digit="{{ i }}">
                                                        <div></div>
                                                        <div class="d-flex justify-content-between">
                                                            <span data-segment="5"></span>
                                                            <span data-segment="1"></span>
                                                        </div>
                                                        <div data-segment="6"></div>
                                                        <div class="d-flex justify-content-between">
                                                            <span data-segment="4"></span>
                                                            <span data-segment="2"></span>
                                                        </div>
                                                        <div data-segment="3"></div>
                                                        <div class="dot" data-segment="7"></div>
                                                    </section>

                                                    <div class="mt-3">
                                                        <div class="d-flex justify-content-center align-items-center gap-1 mb-2">
                                                            <button type="button" class="btn btn-sm btn-outline-primary px-2 py-1" data-direction="prev" data-digit="{{ i }}">-</button>
                                                            <span class="small text-muted fw-bold" style="font-size: 0.8rem;">Znak</span>
                                                            <button type="button" class="btn btn-sm btn-outline-primary px-2 py-1" data-direction="next" data-digit="{{ i }}">+</button>
                                                        </div>
                                                        <div class="segment-text d-flex justify-content-center">
                                                            <input type="text" data-digit="{{ i }}" autocomplete="off" class="form-control text-center p-0" style="width: 2.5em; height: 1.8em; display: inline-block;">
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}

                                        </div>

                                        <div class="text-center mt-2">
                                            <button type="button" class="btn btn-xs btn-outline-danger text-uppercase px-2 py-1" data-direction="wipe" data-digit="0" style="font-size: 0.75rem;">Smazat vše</button>
                                        </div>
                                    </div>
                                {% endif %}
                            </li>
                        {% else %}
                            <li class="list-group-item p-3 text-center text-muted">
                                Žádné ovládací prvky nebyly nalezeny.
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>