{% extends theme_template("base.html.twig") %}

{% block scripts %}
    <script src="{{ theme_asset("main.js") }}"></script>
{% endblock %}

{% block body %}
    <h2 class="section-title">Ovládání kontrolek</h2>

    <div class="controls-grid">
        {% for component in controls %}
            <div data-metrix-id="{{ component.id }}" class="control-card">
                {% if component.type == "switch" %}
                    <div class="control-header">
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" data-part="state" id="switch-{{ component.id }}" {% if component.state %}checked="checked"{% endif %}>
                            <label class="form-check-label fw-bold" for="switch-{{ component.id }}">
                                {{ component.caption }}
                            </label>
                        </div>
                    </div>

                    {% if "blink" in component.parts %}
                        <div class="slave mt-2 pt-2 border-top">
                            <div class="form-check form-switch custom-switch-sm">
                                <input class="form-check-input" type="checkbox" data-part="blink" id="blink-{{ component.id }}" {% if component.blink %}checked="checked"{% endif %}>
                                <label class="form-check-label text-muted small" for="blink-{{ component.id }}">
                                    Blikání
                                </label>
                            </div>
                        </div>
                    {% endif %}

                {% elseif component.type == "segment" %}
                    <div class="segment-block mt-4">
                        <h2 class="h4 fs-5 mb-2">{{ component.caption }}</h2>
                        <div class="segments">
                            {% for index, digit in component.segment_state %}
                                <section class="segment" data-digit="{{ index }}" data-value="{{ digit }}">
                                    <div data-segment="0"></div>
                                    <span data-segment="1"></span>
                                    <span data-segment="2"></span>
                                    <div data-segment="3"></div>
                                    <span data-segment="4"></span>
                                    <span data-segment="5"></span>
                                    <div data-segment="6"></div>
                                    <div class="dot" data-segment="7"></div>
                                </section>
                            {% endfor %}
                        </div>

                        <div class="segment-controls mt-3">
                            <label class="form-label font-weight-bold">Textové vyjádření:</label>
                            <select class="form-select cycle-category mb-2">
                                <option class="default" value="">Vyberte kategorii znaků</option>
                                <option value="digit">číslice</option>
                                <option value="hex">hexadecimální číslice</option>
                                <option value="letteropt">písmena</option>
                                <option value="lower">malá písmena</option>
                                <option value="upper">velká písmena</option>
                                <option value="letter">všechna písmena</option>
                            </select>
                            <p class="text-muted small">Kategorie znaků se uplatní při stisku tlačítek "+" a "-".</p>
                            
                            <div class="segment-text">
                                {% for index, text in component.state %}
                                    <button data-direction="prev" data-digit="{{ index }}">-</button>
                                    <input type="text" data-digit="{{ index }}" data-expected-value="{% if text == "" %} {% else %}{{ text }}{% endif %}" value="{{ text }}">
                                    <button data-direction="next" data-digit="{{ index }}">+</button>
                                    <button data-direction="wipe" data-digit="{{ index }}">🗑</button>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-warning">Unknown component: {{ component.type }}</div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endblock %}