<!DOCTYPE html>
<html lang="cs" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Havlis Theme{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ theme_asset('style.css') }}">
        {% endblock %}
        {% include "header.html.twig" %}
        {% block scripts %}{% endblock %}
    </head>
    <body class="bg-body text-body d-flex flex-column min-vh-100">
        <div class="position-fixed top-0 end-0 p-2 theme-box d-flex align-items-center gap-2">
            <!-- Tlačítko pro přepínání denního/nočního režimu -->
            <button id="modeToggle" class="btn btn-sm btn-outline-secondary bg-black text-light border-secondary" title="Přepnout režim">
                <i id="modeIcon" class="bi bi-sun-fill"></i>
            </button>

            <form action="{{ path("app.set-theme") }}" method="get" class="m-0">
                <input type="hidden" name="back" value="{{ app.request.requesturi }}">
                <select class="form-select form-select-sm submit-on-change bg-black text-light border-secondary theme-select" name="theme">
                    {% for theme in themes %}
                        <option value="{{ theme.theme }}"{% if theme.active %} selected="selected"{% endif %}>
                            {{ theme.description }} ({{ theme.author }})
                        </option>
                    {% endfor %}
                </select>
            </form>
        </div>

        <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary mb-4 navbar-custom">
            <div class="container d-flex justify-content-between align-items-center">
                <a class="navbar-brand fw-bold" href="./">Havlis Theme</a>
                {% if user is not null %}
                    <div class="small text-secondary user-logout-area">
                        <span>{{ user.name }}</span>
                        <a href="{{ path("app.logout") }}" class="text-warning text-decoration-none ms-1">(odhlásit)</a>
                    </div>
                {% endif %}
            </div>
        </nav>

        <main class="container flex-grow-1 mb-5">
            {% block body %}{% endblock %}
        </main>

        <footer class="bg-black text-center text-secondary py-3 mt-auto small">
            Control Panel
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            const htmlElement = document.documentElement;
            const modeToggle = document.getElementById("modeToggle");
            const modeIcon = document.getElementById("modeIcon");

            const savedTheme = localStorage.getItem("preferredTheme") || "dark";
            htmlElement.setAttribute("data-bs-theme", savedTheme);
            updateIcon(savedTheme);

            modeToggle.addEventListener("click", () => {
                const currentTheme = htmlElement.getAttribute("data-bs-theme");
                const newTheme = currentTheme === "dark" ? "light" : "dark";
                
                htmlElement.setAttribute("data-bs-theme", newTheme);
                localStorage.setItem("preferredTheme", newTheme);
                updateIcon(newTheme);
            });

            function updateIcon(theme) {
                if (theme === "light") {
                    modeIcon.className = "bi bi-moon-fill";
                } else {
                    modeIcon.className = "bi bi-sun-fill";
                }
            }
        </script>
    </body>
</html>